# ============================================================
#  SIDR — Variables d'environnement
#  Copiez ce fichier en .env et remplissez vos vraies valeurs
#  NE JAMAIS committer le fichier .env sur GitHub !
# ============================================================

# Votre clé secrète Stripe
# Trouvez-la sur : dashboard.stripe.com > Développeurs > Clés API
STRIPE_SECRET_KEY=sk_live_COLLEZ_VOTRE_CLE_ICI

# L'URL de votre site une fois en ligne (sans slash à la fin)
# Exemple : https://sidr-france.netlify.app
SITE_URL=https://VOTRE_SITE.netlify.app
